# --- Database MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASS=isi_password_mysql_kamu
DB_NAME=mdp_one

# --- Keamanan ---
# Teks acak minimal 32 karakter (dipakai untuk menandatangani sesi login).
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter

# --- Server ---
PORT=3000
# development = tampil detail error di browser. production = detail disembunyikan.
NODE_ENV=development
# Isi 1 jika dibagikan lewat tunnel / hosting (di belakang proxy). Kalau jalan lokal saja, biarkan 0.
TRUST_PROXY=0

# --- Opsional ---
# Email kontak untuk layanan cuaca cadangan (MET Norway meminta identitas aplikasi).
MET_CONTACT_EMAIL=emailkamu@example.com